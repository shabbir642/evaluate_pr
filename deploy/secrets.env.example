# Copy to ~/.config/prboard/secrets.env and `chmod 600` it. Never commit this.

# GitHub: leave unset to let the wrapper use `gh auth token`, or paste a PAT
# with repo + pull_requests:write on the repos you review.
# GITHUB_TOKEN=ghp_xxx

# Slack Socket Mode app (see README "Slack app setup"):
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Your Slack user id — the mention prwatch reacts to.
PRBOARD_SLACK_USER=U02LS4K29KQ

# Lock the trigger down to people you trust: comma-separated Slack user ids.
# Unset = any human in the channel can trigger it (apps are always ignored).
# PRBOARD_ALLOWED_SENDERS=U02LS4K29KQ,U01ABCDEF

# Full path to a python3 that has slack_sdk installed. Leave unset and the
# wrapper picks the first one on PATH that can import it, preferring a .venv
# in the install directory.
# PRBOARD_PYTHON=/opt/homebrew/bin/python3

# STRONGLY recommended for the first runs: watch + log, but take no real action.
# To go live, set it to 0 (or false/no/off), or comment the line out.
PRBOARD_DRY_RUN=1
